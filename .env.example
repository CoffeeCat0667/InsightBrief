# InsightBrief 敏感字段配置
# 复制为 .env 并填入实际值; 环境变量优先于 Config/*.json 中的对应值。
# Config/*.json 中的敏感字段已改为空字符串占位, 必须在此处或系统环境变量中提供。

# ── Core.json 敏感字段 ──
IB_PROXY_DEFAULT=http://127.0.0.1:7897
IB_JWT_SECRET=your-jwt-secret-here
IB_JWT_EXPIRE_SECONDS=86400
IB_ADMIN_USERNAME=admin
IB_ADMIN_PASSWORD=your-admin-password-here
IB_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# ── db.json 敏感字段 ──
# 注意: DSN 中密码的 @ 须 URL 编码为 %40
IB_POSTGRES_DSN=postgresql+psycopg://user:password@127.0.0.1:5432/insightbrief
IB_REDIS_PASSWORD=

# ── LLM.json 敏感字段 ──
IB_LLM_BASE_URL=https://api.example.com/v1
IB_LLM_API_KEY=sk-your-api-key-here
IB_LLM_MODEL_ID=your-model-id
