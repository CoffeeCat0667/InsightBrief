# InsightBrief environment overrides
# Copy to .env (gitignored) to override Config/db.json values

# PostgreSQL (DSN: password @ must be percent-encoded as %40)
# DB_DSN=postgresql+psycopg://postgres:password%40@127.0.0.1:5432/insightbrief

# Redis / Memurai
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Crawl proxy override (empty string disables proxy)
# CRAWL_PROXY=127.0.0.1:7897