# InsightBrief environment overrides
# Copy to .env (gitignored) to override Config/db.json values

# PostgreSQL (DSN: password @ must be percent-encoded as %40)
# DB_DSN=postgresql+psycopg://postgres:password%40@127.0.0.1:5432/insightbrief

# Redis / Memurai
# REDIS_HOST=127.0.0.1
# REDIS_PORT=6379
# REDIS_DB=0
# REDIS_PASSWORD=

# Crawl proxy override (empty string disables proxy)
# CRAWL_PROXY=127.0.0.1:7897

# Auth (production MUST set these)
# JWT_SECRET=<random hex, e.g. python -c "import secrets; print(secrets.token_hex(32))">
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=<strong password>

# Disable interactive API docs (/docs, /redoc, /openapi.json) for production
# IB_DISABLE_DOCS=1

# LLM API key override (overrides Config/LLM.json api_key at startup sync;
# keeps the key out of the git-tracked file)
# LLM_API_KEY=sk-xxxx