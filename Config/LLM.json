{
  "timeout_s": 600,
  "concurrency": 4,
  "quarantine_consecutive": 3,
  "retry": {
    "attempts": 3,
    "backoff_s": [
      1,
      2,
      4
    ]
  },
  "operators": {
    "classify": {
      "max_batch": 20,
      "categories": [
        "政治",
        "经济",
        "文化",
        "科技"
      ]
    },
    "summarize": {
      "max_tokens": 300
    },
    "translate_title": {
      "fallback_translator": true
    },
    "compose_overview": {
      "max_tokens": 800
    }
  }
}
